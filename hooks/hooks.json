{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/poids-de-session.mjs\"", "timeout": 10 } ] },
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/aiguillage.mjs\"", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Agent|Task|mcp__ccd_session__start_session",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/aiguillage.mjs\"", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/verdict.mjs\"", "timeout": 10 } ] },
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/attente.mjs\"", "timeout": 5 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/attente.mjs\"", "timeout": 5 } ] }
    ]
  }
}
